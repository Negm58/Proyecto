# Variables de Entorno - Backend

# Servidor
PORT=5000
NODE_ENV=development

# Base de datos SQLite (Desarrollo)
DATABASE_URL="file:./dev.db"

# Para producción con PostgreSQL:
# DATABASE_URL="postgresql://inventario_admin:inventario_secure_2024@localhost:5432/inventario_restaurante?schema=public"

# JWT
JWT_SECRET=tu_clave_secreta_super_segura_cambiar_en_produccion_2024
JWT_EXPIRES_IN=7d

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Google Gemini API (Asistente IA)
GEMINI_API_KEY=

# Configuración de Alertas (Cron expressions)
STOCK_CHECK_CRON=0 */4 * * *
EXPIRATION_CHECK_CRON=0 8 * * *
BACKUP_CRON=0 2 * * 0

# Margen de ganancia por defecto (%)
DEFAULT_PROFIT_MARGIN=30
