// Prisma Schema - Sistema de Gestión de Inventario
// Restaurante Pollos La Llovizna
// Desarrollo: SQLite | Producción: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTENTICACIÓN Y USUARIOS (RBAC)
// ==========================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relaciones
  userRoles           UserRole[]
  sales               Sale[]
  inventoryMovements  InventoryMovement[]
  operationalExpenses OperationalExpense[]
  backupLogs          BackupLog[]
  aiChatHistory       AiChatHistory[]

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  // Relaciones
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  module      String  // 'inventory', 'menu', 'stats', 'users', 'backups', 'ai', 'sales'
  action      String  // 'create', 'read', 'update', 'delete'
  description String?

  // Relaciones
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId String @map("user_id")
  roleId Int    @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// INVENTARIO / MATERIA PRIMA
// ==========================================

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  // Relaciones
  products Product[]

  @@map("categories")
}

model Supplier {
  id           Int      @id @default(autoincrement())
  name         String
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  address      String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relaciones
  productSuppliers ProductSupplier[]
  inventoryLots    InventoryLot[]
  priceHistory     PriceHistory[]

  @@map("suppliers")
}

model Product {
  id                Int      @id @default(autoincrement())
  name              String
  description       String?
  categoryId        Int?     @map("category_id")
  unitOfMeasure     String   @map("unit_of_measure") // 'kg', 'L', 'unidades', 'g', 'ml'
  currentPrice      Float    @default(0) @map("current_price")
  minStockThreshold Float    @default(0) @map("min_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relaciones
  category           Category?           @relation(fields: [categoryId], references: [id])
  productSuppliers   ProductSupplier[]
  inventoryLots      InventoryLot[]
  recipeItems        RecipeItem[]
  inventoryMovements InventoryMovement[]
  priceHistory       PriceHistory[]
  alerts             Alert[]

  @@map("products")
}

model ProductSupplier {
  id               Int       @id @default(autoincrement())
  productId        Int       @map("product_id")
  supplierId       Int       @map("supplier_id")
  lastPrice        Float?    @map("last_price")
  lastPurchaseDate DateTime? @map("last_purchase_date")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model InventoryLot {
  id                Int       @id @default(autoincrement())
  productId         Int       @map("product_id")
  supplierId        Int?      @map("supplier_id")
  quantityInitial   Float     @map("quantity_initial")
  quantityRemaining Float     @map("quantity_remaining")
  purchasePrice     Float     @map("purchase_price")
  entryDate         DateTime  @default(now()) @map("entry_date")
  expirationDate    DateTime? @map("expiration_date")
  lotCode           String?   @map("lot_code")
  status            String    @default("ACTIVE") // ACTIVE, DEPLETED, EXPIRED
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relaciones
  product            Product             @relation(fields: [productId], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  inventoryMovements InventoryMovement[]

  @@map("inventory_lots")
}

model InventoryMovement {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  lotId        Int?     @map("lot_id")
  userId       String   @map("user_id")
  movementType String   @map("movement_type") // ENTRY, SALE_DEDUCTION, ADJUSTMENT, WASTE, EXPIRATION
  quantity     Float
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relaciones
  product Product       @relation(fields: [productId], references: [id])
  lot     InventoryLot? @relation(fields: [lotId], references: [id])
  user    User          @relation(fields: [userId], references: [id])

  @@map("inventory_movements")
}

// ==========================================
// MENÚ, PLATOS Y COMBOS (RECETARIO)
// ==========================================

model MenuItem {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  type            String   // 'PLATO', 'COMBO'
  productionCost  Float    @default(0) @map("production_cost")
  suggestedPrice  Float    @default(0) @map("suggested_price")
  salePrice       Float    @default(0) @map("sale_price")
  profitMarginPct Float    @default(30) @map("profit_margin_pct")
  imageUrl        String?  @map("image_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relaciones
  recipeItems RecipeItem[]
  comboItems  ComboItem[]  @relation("ComboChild")
  comboParent ComboItem[]  @relation("ComboParent")
  saleItems   SaleItem[]

  @@map("menu_items")
}

model RecipeItem {
  id             Int    @id @default(autoincrement())
  menuItemId     Int    @map("menu_item_id")
  productId      Int    @map("product_id")
  quantityNeeded Float  @map("quantity_needed")
  unitOfMeasure  String @map("unit_of_measure")

  // Relaciones
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([menuItemId, productId])
  @@map("recipe_items")
}

model ComboItem {
  id         Int @id @default(autoincrement())
  comboId    Int @map("combo_id")
  menuItemId Int @map("menu_item_id")
  quantity   Int @default(1)

  // Relaciones
  combo    MenuItem @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation("ComboChild", fields: [menuItemId], references: [id])

  @@map("combo_items")
}

// ==========================================
// VENTAS
// ==========================================

model Sale {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id")
  totalAmount   Float    @map("total_amount")
  totalCost     Float    @default(0) @map("total_cost")
  paymentMethod String?  @map("payment_method") // 'EFECTIVO', 'TARJETA', 'TRANSFERENCIA'
  status        String   @default("COMPLETED") // COMPLETED, CANCELLED
  saleDate      DateTime @default(now()) @map("sale_date")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relaciones
  user      User       @relation(fields: [userId], references: [id])
  saleItems SaleItem[]

  @@map("sales")
}

model SaleItem {
  id         Int   @id @default(autoincrement())
  saleId     Int   @map("sale_id")
  menuItemId Int   @map("menu_item_id")
  quantity   Int
  unitPrice  Float @map("unit_price")
  subtotal   Float

  // Relaciones
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("sale_items")
}

// ==========================================
// ESTADÍSTICAS Y REPORTES
// ==========================================

model PriceHistory {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  supplierId Int?     @map("supplier_id")
  oldPrice   Float    @map("old_price")
  newPrice   Float    @map("new_price")
  recordedAt DateTime @default(now()) @map("recorded_at")

  // Relaciones
  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@map("price_history")
}

model OperationalExpense {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id")
  category    String   // 'ALQUILER', 'SERVICIOS', 'SALARIOS', 'MANTENIMIENTO', 'OTRO'
  description String?
  amount      Float
  expenseDate DateTime @map("expense_date")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relaciones
  user User @relation(fields: [userId], references: [id])

  @@map("operational_expenses")
}

// ==========================================
// ALERTAS
// ==========================================

model Alert {
  id        Int      @id @default(autoincrement())
  productId Int?     @map("product_id")
  alertType String   @map("alert_type") // 'LOW_STOCK', 'EXPIRING_SOON', 'EXPIRED'
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  product Product? @relation(fields: [productId], references: [id])

  @@map("alerts")
}

// ==========================================
// AGENTE IA
// ==========================================

model AiChatHistory {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id")
  userMessage String   @map("user_message")
  aiResponse  String   @map("ai_response")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relaciones
  user User @relation(fields: [userId], references: [id])

  @@map("ai_chat_history")
}

// ==========================================
// BACKUPS
// ==========================================

model BackupLog {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  backupType String   @map("backup_type") // 'MANUAL', 'SCHEDULED'
  filePath   String?  @map("file_path")
  status     String   @default("SUCCESS") // SUCCESS, FAILED
  driveUrl   String?  @map("drive_url")
  fileSize   String?  @map("file_size")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relaciones
  user User @relation(fields: [userId], references: [id])

  @@map("backup_logs")
}
